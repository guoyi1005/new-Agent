# Copy to deploy/.env and replace every CHANGE_ME value before startup.
IMAGE_TAG=submission
BACKEND_IMAGE=agent-a3/backend
AI_SERVER_IMAGE=agent-a3/ai-server
WEB_IMAGE=agent-a3/web
FRONTEND_IMAGE=agent-a3/frontend
MYSQL_IMAGE=mysql:8.4.5
REDIS_IMAGE=redis:7.4.2-alpine
NEO4J_IMAGE=neo4j:5.26-community

MYSQL_DATABASE=smart-campus
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
NEO4J_PASSWORD=CHANGE_ME_neo4j_password
BACKEND_PORT=18080
AI_PORT=18081
WEB_PORT=3000
FRONTEND_PORT=5174
DEPLOY_FORCE_RELEASE_PORTS=true
DEPLOY_RELEASE_PORTS=8080 8081 18080 18081 3000 5174

JWT_SECRET=CHANGE_ME_use_at_least_64_random_characters_for_hmac_signing
CODE_JUDGE_INTERNAL_TOKEN=CHANGE_ME_use_at_least_32_random_characters
AI_INTERNAL_TOKEN=CHANGE_ME_use_a_separate_random_secret_for_java_python_calls
# Keep aligned with the environment that wrote encrypted DB secrets (model keys, Langfuse).
# Local default when JWT_SECRET / APP_CREDENTIAL_ENCRYPTION_KEY were unset:
APP_CREDENTIAL_ENCRYPTION_KEY=smart-campus-local-credential-encryption-key-change-me
JWT_EXPIRATION_MS=86400000
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m
PUBLIC_BASE_URL=http://localhost:3000

# Optional map/object-storage integrations. Empty values keep unrelated campus
# pages bootable, but their external-provider actions require real credentials.
TENCENT_MAP_KEY=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
AMAP_APP_KEY=
AMAP_WEB_KEY=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# External MaxKB and model values are intentionally not baked into images.
# Configure them in the administrator UI after boot; keep this section as the
# local handoff record and never commit deploy/.env.
MAXKB_BASE_URL=
MAXKB_API_KEY=
MAXKB_WORKSPACE_ID=
MAXKB_KNOWLEDGE_ID=
LLM_PROVIDER=xfyun
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_FALLBACKS=qwen3.7-max-2026-05-17,qwen3.7-max-preview,kimi-k3,deepseek-v4-flash-0731,glm-5.2,kimi-k2.7-code,deepseek-v4-pro-0813,qwen3.5-ocr,qwen3.7-plus-2026-05-26

# AI 模拟面试面试官（Java 后端）使用的 DeepSeek 模型。
# 真实密钥只写入本机的 deploy/.env，绝不提交到仓库。
# 两种注入方式二选一即可，均只存在于服务端，前端与仓库都拿不到密钥：
#   1) 这里填写 DEEPSEEK_API_KEY（随部署包交付，适合全新数据库的一次性部署）；
#   2) 启动后在管理端配置模型（写入 ai_model_config，AES-GCM 加密落库，适合长期运行的环境）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AgentA3 built-in PPT engine. Use `legacy` only for emergency rollback.
PPT_DEFAULT_TEMPLATE=general
PPT_TASK_TTL_SECONDS=604800
PPT_SOURCE_FILE_TTL_SECONDS=86400

# Evaluation scripts use these only when a live authenticated environment exists.
EVAL_ENDPOINT=
EVAL_TOKEN=
